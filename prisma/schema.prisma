// drinkAndDraw v3 - Prisma schema
//
// Notes:
// - Auth.js v5 (NextAuth) Prisma adapter models are kept on User/Account/Session/VerificationToken.
// - References (admin-curated reference images) and Drawings (user uploads) share Tags via
//   typed junction tables. Tag.name is the canonical normalized form.
// - Favorites/Votes/Comments are polymorphic via a discriminator (`targetType`).
// - `folderPath` is a normalized string (forward slashes, no leading/trailing slash). Prefix
//   matching with LIKE 'foo/%' is supported by the default btree index on (folderPath).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Auth.js (NextAuth v5) models
// =============================================================================

model User {
  id            String    @id @default(cuid())
  handle        String?   @unique
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  uploadedDrawings  Drawing[]         @relation("DrawingOwner")
  practiceSessions  PracticeSession[]
  favorites         Favorite[]
  votes             Vote[]
  comments          Comment[]
  referenceTagEdits ReferenceTag[]    @relation("ReferenceTagAddedBy")
  drawingTagEdits   DrawingTag[]      @relation("DrawingTagAddedBy")

  @@index([role])
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// References (curated reference image library)
// =============================================================================

model Reference {
  id            String   @id @default(cuid())
  storageKey    String   @unique
  filename      String
  title         String?
  folderPath    String   @default("")
  mimeType      String   @default("image/jpeg")
  width         Int?
  height        Int?
  fileSizeBytes Int?
  source        String   @default("local")
  isPublic      Boolean  @default(true)
  isApproved    Boolean  @default(true)
  viewsCount    Int      @default(0)
  // Precomputed parametric (SMPL) pose data for the stick figure + anatomy rig.
  // poseDataKey: storage key of the <id>.json sidecar (pose/betas/joints) — the
  //   primary driver of the SMPL views (null = none yet).
  // poseMeshKey: storage key of an optional posed .glb (debug/preview only).
  // poseStatus: null = never attempted, "ready", "no_pose", or "failed".
  poseDataKey   String?
  poseMeshKey   String?
  poseStatus    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tags      ReferenceTag[]
  drawings  Drawing[]
  comments  Comment[]      @relation("ReferenceComments")

  @@index([folderPath])
  @@index([isPublic, isApproved])
  @@index([createdAt])
}

model ReferenceTag {
  id          String      @id @default(cuid())
  referenceId String
  tagId       String
  kind        TagKind     @default(USER)
  addedById   String?
  createdAt   DateTime    @default(now())

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation("ReferenceTagAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([referenceId, tagId, kind])
  @@index([tagId, kind])
}

enum TagKind {
  USER
  ADMIN
}

// =============================================================================
// Tags (shared between references and drawings)
// =============================================================================

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  references ReferenceTag[]
  drawings   DrawingTag[]
}

// =============================================================================
// Drawings (user uploads)
// =============================================================================

model Drawing {
  id            String   @id @default(cuid())
  ownerId       String
  referenceId   String?
  storageKey    String   @unique
  filename      String
  title         String?
  description   String?
  mimeType      String   @default("image/png")
  width         Int?
  height        Int?
  fileSizeBytes Int?
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner     User         @relation("DrawingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reference Reference?   @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  tags      DrawingTag[]
  comments  Comment[]    @relation("DrawingComments")

  @@index([ownerId])
  @@index([referenceId])
  @@index([isPublic, createdAt])
}

model DrawingTag {
  id        String  @id @default(cuid())
  drawingId String
  tagId     String
  addedById String?
  createdAt DateTime @default(now())

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("DrawingTagAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([drawingId, tagId])
  @@index([tagId])
}

// =============================================================================
// Practice sessions (timed sessions; optional analytics)
// =============================================================================

model PracticeSession {
  id            String    @id @default(cuid())
  userId        String?
  config        Json
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  imagesShown   Int       @default(0)
  drawingsSaved Int       @default(0)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
}

// =============================================================================
// Polymorphic social (Favorites, Votes, Comments)
// =============================================================================

enum TargetType {
  REFERENCE
  DRAWING
}

enum VoteValue {
  UP
  DOWN
}

model Favorite {
  id         String     @id @default(cuid())
  userId     String
  targetType TargetType
  targetId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Vote {
  id         String     @id @default(cuid())
  userId     String
  targetType TargetType
  targetId   String
  value      VoteValue
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Comment {
  id              String     @id @default(cuid())
  userId          String
  targetType      TargetType
  body            String     @db.Text
  parentCommentId String?
  referenceId     String?
  drawingId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]  @relation("CommentReplies")
  reference     Reference? @relation("ReferenceComments", fields: [referenceId], references: [id], onDelete: Cascade)
  drawing       Drawing?   @relation("DrawingComments", fields: [drawingId], references: [id], onDelete: Cascade)

  @@index([targetType, referenceId])
  @@index([targetType, drawingId])
  @@index([parentCommentId])
}
