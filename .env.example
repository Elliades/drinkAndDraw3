# =============================================================================
# drinkAndDraw v3 - environment example
# Copy to .env.local for development. All variables are validated by src/lib/env.ts.
# =============================================================================

# Required - app
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required - database (Postgres). Local default points at the docker-compose service.
# On Railway: do NOT copy this line — use DATABASE_URL from the PostgreSQL plugin
# (reference ${{Postgres.DATABASE_URL}} on the app service, Build + Deploy).
DATABASE_URL=postgresql://drinkanddraw:drinkanddraw@localhost:5432/drinkanddraw

# Required - auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Optional - Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional - local dev password sign-in on /login (NODE_ENV=development only; min 8 chars).
# Do not set in production.
AUTH_DEV_SECRET=
# Optional - email for the dev user (defaults to dev@drinkanddraw.local)
AUTH_DEV_EMAIL=

# Optional - email (magic links). Leave empty to disable email provider.
EMAIL_SERVER=
EMAIL_FROM=

# Storage driver: "local" (default in dev) or "s3" (default in prod)
STORAGE_DRIVER=local

# Local storage settings (only used when STORAGE_DRIVER=local)
LOCAL_IMAGE_DIR=./sample-images
# Writable thumbnail cache for grid views (WebP, generated on sync or first request)
THUMB_CACHE_DIR=./.cache/thumbs

# Optional: root folder with per-album `tag.txt` for `npm run tags:from-disk` (defaults to F:\ModelVivant on Windows).
MODEL_VIVANT_DIR=
# Optional: include every image basename when deducing tags (can create millions of DB rows). Default: off.
TAG_INCLUDE_FILE_BASENAMES=

# AWS S3 settings (only used when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
# Optional: omit to use the SDK default credential chain (env/instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=references/
# Optional: public or CDN base for object URLs (e.g. CloudFront) when not using presigned URLs alone.
S3_PUBLIC_URL=

# Tag management API + MCP (optional in dev; required in production for /api/tags/v1)
# Generate with: openssl rand -base64 32
TAG_API_KEY=

# Pose search — natural-language queries on /search/pose (optional; keyword fallback if unset)
# DeepSeek (OpenAI-compatible): https://platform.deepseek.com/api_keys
POSE_LLM_API_KEY=
POSE_LLM_BASE_URL=https://api.deepseek.com/v1
POSE_LLM_MODEL=deepseek-chat

# Observability (optional in dev)
SENTRY_DSN=
LOG_LEVEL=info
