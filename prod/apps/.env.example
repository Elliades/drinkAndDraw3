# =============================================================================
# drinkAndDraw v3 - production env for the `apps` server (Coolify Environment tab)
# Set these as environment variables on the Coolify resource. Do NOT commit real values.
# Compose reads them via ${VAR}; LOCAL_IMAGE_DIR / DATABASE_URL host are fixed in compose.
# =============================================================================

# Public URL the app is served on. trustHost=true lets auth work across LAN + Tailscale.
# LAN: http://apps:3081  |  Tailscale: http://100.93.92.42:3081  |  later: https://<domain>
NEXT_PUBLIC_APP_URL=http://apps:3081

# Auth.js secret (NextAuth). Required in production. Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Postgres password for the bundled db service (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# Optional Google OAuth (add prod redirect URI). Leave blank to disable.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Storage is fixed to local in compose (LOCAL_IMAGE_DIR=/data/images, mounted from
# /mnt/d/Data/ModelVivant). No S3 vars are needed for this deployment.
