{
  "name": "drinkanddraw",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "ingest": "tsx scripts/ingest-references.ts",
    "tags:from-folders": "tsx scripts/apply-folder-path-tags.ts",
    "tags:retrieve": "tsx scripts/retrieve-tag-source.ts",
    "tags:deduce": "tsx scripts/deduce-tags-from-source.ts",
    "tags:pipeline": "tsx scripts/sync-tags-pipeline.ts",
    "tags:from-disk": "tsx scripts/sync-reference-tags-from-tagfiles.ts",
    "tags:normalize": "tsx scripts/normalize-reference-tags.ts",
    "mcp:tags": "tsx mcp/drinkanddraw-tags/src/index.ts",
    "env:verify-prod": "tsx scripts/verify-production-env.ts",
    "sync:modelvivant": "tsx scripts/sync-modelvivant.ts",
    "thumbs:backfill": "tsx scripts/backfill-thumbnails.ts",
    "pose3d:manifest": "tsx scripts/pose3d-export-manifest.ts",
    "pose3d:import": "tsx scripts/pose3d-import-meshes.ts",
    "pose-poc:prepare": "tsx scripts/pose-poc-prepare.ts",
    "pose-poc:dev": "next dev --port 3001",
    "postinstall": "prisma generate"
  },
  "dependencies": {
